# Copy to backend-python/.env.local; never commit actual configuration.
# Auth reads process environment; load this file explicitly with uvicorn --env-file.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=
SAVED_ITINERARIES_SCHEMA_VERIFIED=false
APP_MODE=local
TRIP_OWNERSHIP_ENABLED=false
# Use SUPABASE_ANON_KEY instead of SUPABASE_PUBLISHABLE_KEY only for an existing legacy anon key.
# Keep service-role/secret keys server-only; do not place them in frontend variables.
