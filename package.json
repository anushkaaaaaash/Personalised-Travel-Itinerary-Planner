{
  "name": "personalized-travel-itinerary-planner",
  "version": "0.1.0",
  "private": true,
  "description": "AI-powered web app that generates personalized travel itineraries",
  "workspaces": [
    "frontend",
    "backend"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev --workspace=frontend\" \"npm run dev --workspace=backend\"",
    "dev:frontend": "npm run dev --workspace=frontend",
    "dev:backend": "npm run dev --workspace=backend",
    "build": "npm run build --workspace=frontend",
    "start": "npm run start --workspace=backend",
    "test:validation": "node --test shared/test/*.test.mjs",
    "test": "npm run test:validation && npm run test --workspace=frontend && npm run test --workspace=backend"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  },
  "engines": {
    "node": ">=20"
  }
}
