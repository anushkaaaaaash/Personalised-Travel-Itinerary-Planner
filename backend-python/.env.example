# Copy to backend-python/.env.local; never commit actual configuration.
# Auth reads process environment; load this file explicitly with uvicorn --env-file.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=
SAVED_ITINERARIES_SCHEMA_VERIFIED=false
APP_MODE=local
TRIP_OWNERSHIP_ENABLED=false
# Use SUPABASE_ANON_KEY instead of SUPABASE_PUBLISHABLE_KEY only for an existing legacy anon key.
# Keep service-role/secret keys server-only; do not place them in frontend variables.

APP_ENV=development
AI_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna
OPENAI_REASONING_EFFORT=max
# Production/staging requires APP_MODE=production, APP_ENV=production or staging,
# exact API_HOST and HTTPS FRONTEND_ORIGIN; see deployment/ACTIVITY_5_3_5_4.md.
# No custom JWT SECRET_KEY: Supabase Auth manages token signing.
